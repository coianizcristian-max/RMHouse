# Copia questo file in .env.local (in locale) e inserisci gli stessi valori su Vercel → Settings → Environment Variables

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://XXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # SEGRETA: mai nel codice, mai su GitHub

# Palestra servita da questo sito (slug nella tabella palestre)
NEXT_PUBLIC_PALESTRA_SLUG=rmhouse

# Invio email (resend.com → API Keys)
RESEND_API_KEY=re_...

# Chiave condivisa con il cron di Supabase (inventane una lunga e casuale)
CRON_SECRET=cambia-questa-stringa-lunga-e-casuale

# Pagamenti online delle prove: finché è "false" le prove a pagamento
# vengono confermate e si pagano in sede (Stripe arriva nella fase 2)
PAGAMENTI_ONLINE=false

# Notifiche push sul telefono (si generano una volta sola con: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SOGGETTO=mailto:segreteria@ritmometropolitano.com
